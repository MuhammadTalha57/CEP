# Copy to .env (never commit .env). Values are read by configs/*.yaml via ${VAR:-default}.
OLLAMA_URL=http://localhost:11434/v1
# Optional key for OpenAI-compatible servers that need one (Ollama does not).
LLM_API_KEY=
# Key the harness sends to the app server (X-API-Key header).
APP_API_KEY=change-me
